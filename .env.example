# Patel Restaurant - GitHub-only Architecture
# No Supabase. No external database. No external image storage.
#
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to GitHub.

# ── GitHub Content Repository (Required) ──
# Create a private GitHub repository for menu data and images.
# Example: https://github.com/yourusername/patel-restaurant-content
GITHUB_TOKEN=your_fine_grained_personal_access_token
GITHUB_OWNER=your_github_username_or_org
GITHUB_REPO=patel-restaurant-content
GITHUB_BRANCH=main

# ── Admin Authentication (Required) ──
# Create a strong random string (32+ characters) for session signing.
# Example: openssl rand -hex 32
AUTH_SECRET=your_session_signing_secret

# Admin email for dashboard login
ADMIN_EMAIL=admin@patelrestaurant.com

# Admin password hash (bcrypt)
# Generate with: node -e "import('bcryptjs').then(b => b.hash('your-password', 12).then(console.log))"
ADMIN_PASSWORD_HASH=$2a$12$your_generated_hash_here

# ── Optional ──
# Application URL for QR codes and links
NEXT_PUBLIC_APP_URL=https://patel-restaurant.vercel.app